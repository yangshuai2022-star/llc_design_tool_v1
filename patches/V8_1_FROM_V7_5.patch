+            f"Vo={metrics.output_voltage_v:9.5f} V  "
+            f"Ir_rms={metrics.resonant_current_rms_a:9.5f} A  "
+            f"dIr={row.resonant_rms_error_percent:+8.3f}%"
+        )
+    for warning in analysis.warnings:
+        click.echo(f"  WARNING: {warning}")
